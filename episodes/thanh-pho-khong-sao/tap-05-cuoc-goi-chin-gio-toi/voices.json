  },
  {
   "file": "c4_minh",
   "voice": "minh",
   "text": "Rồi má nói học phí của em tháng này má lo, con khỏi gửi. Má tính hỏi vay bà Năm bên xóm, chịu lời cũng được, con trên đó cũng tốn.",
   "tempo": 1.0,
   "scene": "c4-ma-tinh-vay",
   "pause": 1.2,
   "inner_pauses": [
    {
     "after_part": 1,
