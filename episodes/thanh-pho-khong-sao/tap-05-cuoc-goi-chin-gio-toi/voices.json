   ]
  },
  {
   "file": "c5_minh",
   "voice": "minh",
   "text": "Nghe tới chữ vay là tay siết cái điện thoại. Tháng nào cũng là mình gửi tiền về, giờ má phải đi hỏi vay, còn mình thì ngồi im.",
   "tempo": 1.0,
