  {
   "file": "c3_minh",
   "voice": "minh",
   "text": "Bữa nay má không hỏi con ăn cơm chưa, vô thẳng chuyện dừa luôn. Sau lưng má là đống dừa chất cao, thương lái trả có mấy ngàn một trái, bán không đủ tiền công hái.",
   "tempo": 1.0,
   "scene": "c3-dong-dua",
